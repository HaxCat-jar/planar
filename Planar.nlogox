<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[

;;;;;;;;;;;;;;;; GAME-EXTERNAL PROCEDURES ;;;;;;;;;;;;;;;;




;;;;;;;;;;;;;;;;;;;;;;;
;; DETERMINATE SETUP ;;
;;;;;;;;;;;;;;;;;;;;;;;



globals [
  
  instance-counter
  default-character?
  
  open_settings?
  start_game?
  return_to_menu?
  
  
  
  selection-x
  selection-y
  
  icon-selection-x
  icon-selection-y
  
  selected-color
  selected-icon
  
  color-selection-x
  color-selection-y
  
  player_color
  player_icon
  
  
  
  player_x
  player_y
  gravity-direction
  
  
  
  portal-1-x
  portal-1-y
  
  portal-2-x
  portal-2-y
  
  portal-exit-color
  
  portal-1-heading
  portal-2-heading
  
  portal-exit-offset-x
  portal-exit-offset-y
  
]

;Import the bitmap extension for image importing
extensions [ bitmap ]



turtles-own [
  
  player?
  
]






;Setup for testing purposes ONLY
to test_setup
  
  ca
  
  create-turtles 1 [
    setxy 0 0
    set shape "chess pawn"
    set color violet
    set size 20
    set heading 0
    set player? true
    
  ]
  
  set gravity-direction 2
  
  ask patches [
    
    if pycor <= 75 and pycor >= -75 and pxcor > 75 [
      set pcolor 5
    ]   
    
    if pycor <= 75 and pycor >= -75 and pxcor < -75 [
      set pcolor 5
    ]
    
    
    
    if pxcor <= 75 and pxcor >= -75 and pycor > 75 [
      set pcolor 5
    ]   
    
    if pxcor <= 75 and pxcor >= -75 and pycor < -75 [
      set pcolor 5
    ]
    
  ]
  
  set portal-1-x -75
  set portal-1-y -73
  
  create_portal_1_y
  
  
  
  set portal-2-x 74
  set portal-2-y -73
  
  create_portal_2_y
  
end



;Action procedure to start all game functions
to run_game
  
  ca
  reset-ticks
  
  set instance-counter 0
  set default-character? true
  
  game_menu
  
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MAIN SCREEN PROCEDURES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;


;Creates the main menu screen
to game_menu
  
  ask patches [ set pcolor black ]
  
  clear-drawing
  
  ask turtles [ die ]
  
  set instance-counter (instance-counter + 1)
  
  if instance-counter >= 2 [
    set default-character? false
  ]
  
  set start_game? false
  set open_settings? false
  
  game_name
  play_button
  settings_button
  menu_portals
  
  while [start_game? = false and open_settings? = false] [
    
    wait 0.05
    
    menu_portal_colorize
    
    if mouse-xcor >= -25 and mouse-xcor <= 25 and mouse-ycor >= -74 and mouse-ycor <= -50 and mouse-down? = true [
      set open_settings? true
      settings_button_press
    ]
    
    if mouse-xcor >= -25 and mouse-xcor <= 25 and mouse-ycor >= -34 and mouse-ycor <= -10 and mouse-down? = true [
      set start_game? true
      play_button_press
    ]
    
  ]
  
  
  wait 0.2
  
  if open_settings? = true [
    settings_screen
  ]
  
  if start_game? = true [
    
    wait 0.8
    
    transition_from_menu
    
    wait 3
  ]
  
end





;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETTINGS SCREEN PROCEDURES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;




;Settings setup for testing ONLY
to settings_test
  set default-character? true
  settings_screen
end




;Creates the settings screen
to settings_screen
  
  clear-drawing
  
  if default-character? = true [
    set player_color 9.9
    set player_icon "person"
  ]
  
  
  
  ask patches [
    set pcolor black
  ]
  
  ask turtles [
    die
  ]
  
  menu_button
  settings_logo
  color_heading
  icon_heading
  preview_heading
  
  color_select
  icon_select
  
  create-turtles 1 [
    
    pu
    set size 75
    set heading 0
    setxy 55 -15
    
    set color player_color
    set shape player_icon
    
  ]
  
  display
  
  wait 0.01
  
  settings
end




;Runs the settings procedures (option selecting and character preview)
to settings
  
  set return_to_menu? false
  
  while [return_to_menu? = false] [
    
    ;Color selection
    if mouse-xcor >= -80 and mouse-xcor <= -10 and mouse-ycor <= 25 and mouse-ycor >= -45 and mouse-down? = true [
      
      set selected-color [pcolor] of patch (round mouse-xcor) (round mouse-ycor)
      
      set color-selection-x [pxcor] of one-of patches with [(pcolor = selected-color) and not any? other patches in-radius 2 with [pcolor != selected-color]]
      set color-selection-y [pycor] of one-of patches with [(pcolor = selected-color) and not any? other patches in-radius 2 with [pcolor != selected-color]]
      
      ask turtles with [shape = "color outline"] [
        setxy color-selection-x color-selection-y
      ]
      
      set player_color selected-color
      
      ask turtles with [size = 75] [
        
        set color selected-color
        
      ]
    ]
    
    
    
    ;Icon selection
    if mouse-xcor >= -90 and mouse-xcor <= 5 and mouse-ycor >= -95 and mouse-ycor <= -55 and mouse-down? = true [
      
      set icon-selection-x [xcor] of min-one-of other turtles with [size = 15] [distancexy mouse-xcor mouse-ycor]
      set icon-selection-y [ycor] of min-one-of other turtles with [size = 15] [distancexy mouse-xcor mouse-ycor]
      
      ask turtles with [shape = "icon selection"] [
        setxy icon-selection-x icon-selection-y
      ]
      
      set player_icon [shape] of one-of turtles with [shape != "icon selection" and xcor = icon-selection-x and ycor = icon-selection-y]
      
      ask turtles with [size = 75] [
        set shape player_icon
      ]
    ]
    
    
    
    ;Pressing the "Menu" button
    if mouse-xcor >= -89 and mouse-xcor <= -41 and mouse-ycor >= 68 and mouse-ycor <= 88 and mouse-down? = true [
      
      menu_button_press
      
      set return_to_menu? true
      
    ]
  ]
  
  if return_to_menu? = true [
    
    set open_settings? false
    
    game_menu
    
  ]
  
end


















;;;;;;;;;;;;;;;; GAMEPLAY ;;;;;;;;;;;;;;;;




;;;;;;;;;;;;;;;;;;;;;;;;
;; MOVEMENT & PHYSICS ;;
;;;;;;;;;;;;;;;;;;;;;;;;


;; Gravity Direction Guide ;;
;;       0 = up            ;;
;;       1 = right         ;;
;;       2 = down          ;;
;;       3 = left          ;;



to move_left
  
  make_gravity
  
  set player_x [xcor] of turtle 0
  set player_y [ycor] of turtle 0
  
  ask one-of turtles with [player? = true] [
    
    if gravity-direction = 0 [
      if patch (player_x + 3) player_y != nobody and [pcolor] of patch (player_x + 7) player_y = black [
        setxy (player_x + 3) player_y
      ]
    ]
    
    if gravity-direction = 1 [
      if patch player_x (player_y - 3) != nobody and [pcolor] of patch player_x (player_y - 9) = black [
        setxy player_x (player_y - 3)
      ]
    ]
    
    if gravity-direction = 2 [
      if patch (player_x - 3) player_y != nobody and [pcolor] of patch (player_x - 7) player_y = black [
        setxy (player_x - 3) player_y
      ]
    ]
    
    if gravity-direction = 3 [
      if patch player_x (player_y + 3) != nobody and [pcolor] of patch player_x (player_y + 9) = black [
        setxy player_x (player_y + 3)
      ]
    ]
  ]
  
  make_gravity
  check_for_portals
  
end

to move_right
  
  make_gravity
  
  set player_x [xcor] of turtle 0
  set player_y [ycor] of turtle 0
  
  ask one-of turtles with [player? = true] [
    
    if gravity-direction = 0 [
      if patch (player_x - 3) player_y != nobody and [pcolor] of patch (player_x - 7) player_y = black [
        setxy (player_x - 3) player_y
      ]
    ]
    
    if gravity-direction = 1 [
      if patch player_x (player_y + 3) != nobody and [pcolor] of patch player_x (player_y + 9) = black [
        setxy player_x (player_y + 3)
      ]
    ]
    
    if gravity-direction = 2 [
      if patch (player_x + 3) player_y != nobody and [pcolor] of one-of patches with [pxcor = (player_x + 7) and pycor = player_y] = black [
        setxy (player_x + 3) player_y
      ]
    ]
    
    if gravity-direction = 3 [
      if patch player_x (player_y - 3) != nobody and [pcolor] of patch player_x (player_y - 9) = black [
        setxy player_x (player_y - 3)
      ]
    ]
  ]
  
  make_gravity
  check_for_portals
  
end


to jump_up
  
  
  make_gravity
  
  ask one-of turtles with [player? = true] [
    
    if gravity-direction = 0 [
      
      repeat 4 [
        setxy xcor (ycor - 3)
        wait 0.01
      ]
      
      repeat 2 [
        setxy xcor (ycor - 1)
        wait 0.05
      ]
      
      wait 0.1
      
      repeat 2 [
        setxy xcor (ycor + 1)
        wait 0.01
      ]
      
      repeat 4 [
        setxy xcor (ycor + 3)
        wait 0.05
      ]
      
    ]
    
    
    if gravity-direction = 1 [
      
      repeat 4 [
        setxy (xcor - 3) ycor
        wait 0.01
      ]
      
      repeat 2 [
        setxy (xcor - 1) ycor
        wait 0.05
      ]
      
      wait 0.1
      
      repeat 2 [
        setxy (xcor + 1) ycor
        wait 0.01
      ]
      
      repeat 4 [
        setxy (xcor + 3) ycor
        wait 0.05
      ]
    ]
    
    
    if gravity-direction = 2 [
      
      repeat 4 [
        setxy xcor (ycor + 3)
        wait 0.01
      ]
      
      repeat 2 [
        setxy xcor (ycor + 1)
        wait 0.05
      ]
      
      wait 0.1
      
      repeat 2 [
        setxy xcor (ycor - 1)
        wait 0.01
      ]
      
      repeat 4 [
        setxy xcor (ycor - 3)
        wait 0.05
      ]
    ]
    
    
    if gravity-direction = 3 [
      
      repeat 4 [
        setxy (xcor + 3) ycor
        wait 0.01
      ]
      
      repeat 2 [
        setxy (xcor + 1) ycor
        wait 0.05
      ]
      
      wait 0.1
      
      repeat 2 [
        setxy (xcor - 1) ycor
        wait 0.01
      ]
      
      repeat 4 [
        setxy (xcor - 3) ycor
        wait 0.05
      ]
      
    ]
  ]
  
  make_gravity
  
end



to make_gravity
  
  ask turtles with [player? = true] [
    
    if gravity-direction = 0 [
      
      while [[pcolor] of patch xcor (ycor + 11) = black] [
        setxy xcor (pycor + 1)
        wait 0.007
      ]
    ]
    
    
    if gravity-direction = 1 [
      
      while [[pcolor] of patch (xcor + 11) ycor = black] [
        setxy (xcor + 1) ycor
        wait 0.007
      ]
    ]
    
    
    if gravity-direction = 2 [
      
      while [[pcolor] of patch xcor (ycor - 11) = black] [
        setxy xcor (ycor - 1)
        wait 0.007
      ]
    ]
    
    
    if gravity-direction = 3 [
      
      while [[pcolor] of patch (xcor - 11) ycor = black] [
        setxy (xcor - 1) ycor
        wait 0.007
      ]
    ]
  ]
  
end



to switch_gravity
  
  set player_x [xcor] of turtle 0
  set player_y [ycor] of turtle 0
  
  ask one-of turtles with [player? = true] [
    
    if gravity-direction = 0 [
      
      if [pcolor] of patch (player_x + 7) player_y = 5 [
        set gravity-direction 1
        set heading 270
        
        setxy (xcor - 4) (ycor + 4)
      ]
      
      if [pcolor] of patch (player_x - 7) player_y = 5 [
        set gravity-direction 3
        set heading 90
        
        setxy (xcor + 4) (ycor + 4)
      ]
    ]
    
    
    
    if gravity-direction = 1 [
      
      if [pcolor] of patch player_x (player_y + 9) = 5 [
        set gravity-direction 0
        set heading 180
        
        setxy (xcor + 4) (ycor - 4)
      ]
      
      if [pcolor] of patch player_x (player_y - 9) = 5 [
        set gravity-direction 2
        set heading 0
        
        setxy (xcor + 4) (ycor + 4)
      ]
    ]
    
    
    
    if gravity-direction = 2 [
      
      if [pcolor] of patch (player_x + 7) player_y = 5 [
        set gravity-direction 1
        set heading 270
        
        setxy (xcor - 4) (ycor - 4)
      ]
      
      if [pcolor] of patch (player_x - 7) player_y = 5 [
        set gravity-direction 3
        set heading 90
        
        setxy (xcor + 4) (ycor - 4)
      ]
    ]
    
    
    
    if gravity-direction = 3 [
      
      if [pcolor] of patch player_x (player_y + 9) = 5 [
        set gravity-direction 0
        set heading 180
        
        setxy (xcor - 4) (ycor - 4)
      ]
      
      if [pcolor] of patch player_x (player_y - 9) = 5 [
        set gravity-direction 2
        set heading 0
        
        setxy (xcor - 4) (ycor + 4)
      ]
    ]
    
    
  ]
  
end



to check_for_portals
  
  ask turtles [
    
    if gravity-direction = 2 [
      
      if [pcolor] of patch (xcor + 6) ycor = blue or [pcolor] of patch (xcor - 6) ycor = blue or [pcolor] of patch xcor (ycor - 8) = blue [
        set portal-exit-color orange
        set portal-reference-x (portal-2-x - xcor)
        set portal-reference-y (portal-2-y - ycor)
        
        go_through_portal
      ]
      
      if [pcolor] of patch (xcor + 6) ycor = orange or [pcolor] of patch (xcor - 6) ycor = orange or [pcolor] of patch xcor (ycor - 8) = orange [
        set portal-exit-color blue
        set portal-reference-x (portal-1-x - xcor)
        set portal-reference-y (portal-2-y - ycor)
        
        go_through_portal
      ]
    ]
    
  ]
  
end



to go_through_portal
  
  
  
end




to interact_with_item
  
  
  
end




to create_portal_1_x
  
  ask patches [
    
    if pxcor >= portal-1-x and pxcor <= (portal-1-x + 20) and pycor >= portal-1-y and pycor <= (portal-1-y + 1) [
      set pcolor blue
    ]
  ]
  
  if [pcolor] of patch portal-1-x 
  
end

to create_portal_1_y
  
  ask patches [
    
    if pxcor >= portal-1-x and pxcor <= (portal-1-x + 1) and pycor >= portal-1-y and pycor <= (portal-1-y + 20) [
      set pcolor blue
    ]
  ]
  
end

to create_portal_2_x
  
  ask patches [
    
    if pxcor >= portal-2-x and pxcor <= (portal-2-x + 20) and pycor >= portal-2-y and pycor <= (portal-2-y + 1) [
      set pcolor orange
    ]
  ]
  
end


to create_portal_2_y
  
  ask patches [
    
    if pxcor >= portal-2-x and pxcor <= (portal-2-x + 1) and pycor >= portal-2-y and pycor <= (portal-2-y + 20) [
      set pcolor orange
    ]
  ]
  
end





to intro_level
  
  
  
end



to level_1
  
end

to level_2
  
end

to level_3
  
end

to level_4
  
end

to level_5
  
end














;;;;;;;;;;;;;;;; SETUP PROCEDURES ;;;;;;;;;;;;;;;;






;;;;;;;;;;;;;;;
;; MAIN MENU ;;
;;;;;;;;;;;;;;;





;Create the game name
to game_name
  
  let OG_logo bitmap:import "planar_logo.png"
  let scaled_logo bitmap:scaled OG_logo 500 500
  
  bitmap:copy-to-drawing scaled_logo 65 -100
  
end




;Create the "play" button
to play_button
  
  ask patches [
    
    ;Create the top and bottom of the "Play" button
    
    if pycor = -10 and pxcor >= -25 and pxcor <= 25 [
      set pcolor 2
    ]
    
    if pycor = -11 and pxcor >= -26 and pxcor <= 26 [
      set pcolor 2
    ]
    
    if pycor = -34 and pxcor >= -25 and pxcor <= 25 [
      set pcolor 2
    ]
    
    if pycor = -33 and pxcor >= -26 and pxcor <= 26 [
      set pcolor 2
    ]
    
    
    ;Create the sides of the "Play" button
    
    if pxcor = -25 and pycor >= -34 and pycor <= -10 [
      set pcolor 2
    ]
    
    if pxcor = -26 and pycor >= -33 and pycor <= -11 [
      set pcolor 2
    ]
    
    if pxcor = 26 and pycor >= -33 and pycor <= -11 [
      set pcolor 2
    ]
    
    if pxcor = 25 and pycor >= -34 and pycor <= -10 [
      set pcolor 2
    ]
    
    
    ;Fill the "Play" button with light gray
    
    if pxcor >= -24 and pxcor <= 24 and pycor >= -32 and pycor <= -12 [
      set pcolor 5
    ]
    
    ;Add corner color
    
    ask patch -24 -32 [
      set pcolor 2
    ]
    
    ask patch -24 -12 [
      set pcolor 2
    ]
    
    ask patch 24 -32 [
      set pcolor 2
    ]
    
    ask patch 24 -12 [
      set pcolor 2
    ]
  ]
  
  create-turtles 1 [
    
    ;Set up the turtle
    pu
    set pen-size 5
    set color 0
    setxy -15 -27
    set heading 0
    
    
    ;Create the 'P'
    pd
    fd 12
    rt 90
    
    repeat 20 [
      fd 0.5
      rt 9
    ]
    
    ;Create the 'l'
    pu
    setxy -7 -27
    set heading 0
    
    pd
    fd 12
    
    ;Create the 'a'
    pu
    setxy 5 -27
    set heading 0
    
    pd
    fd 3
    repeat 27 [
      fd 0.75
      lt 13
    ]
    
    ;Create the 'y'
    pu
    setxy 10 -30
    set heading 30
    
    pd
    fd 10
    lt 180
    fd 5
    rt 120
    fd 5
    
    die
  ]
  
end



;;;;;;;;;;;;;;;;;;;;;
;; SETTINGS SCREEN ;;
;;;;;;;;;;;;;;;;;;;;;


;Create the "settings" button
to settings_button
  
  ask patches [
    
    ;Create the top and bottom of the "Settings" button
    
    if pycor = -50 and pxcor >= -25 and pxcor <= 25 [
      set pcolor 2
    ]
    
    if pycor = -51 and pxcor >= -26 and pxcor <= 26 [
      set pcolor 2
    ]
    
    if pycor = -74 and pxcor >= -25 and pxcor <= 25 [
      set pcolor 2
    ]
    
    if pycor = -73 and pxcor >= -26 and pxcor <= 26 [
      set pcolor 2
    ]
    
    
    ;Create the sides of the "Settings" button
    
    if pxcor = -25 and pycor >= -74 and pycor <= -50 [
      set pcolor 2
    ]
    
    if pxcor = -26 and pycor >= -73 and pycor <= -51 [
      set pcolor 2
    ]
    
    if pxcor = 26 and pycor >= -73 and pycor <= -51 [
      set pcolor 2
    ]
    
    if pxcor = 25 and pycor >= -74 and pycor <= -50 [
      set pcolor 2
    ]
    
    
    ;Fill the "Settings" button with light gray
    
    if pxcor >= -24 and pxcor <= 24 and pycor >= -72 and pycor <= -52 [
      set pcolor 5
    ]
    
    ;Add corner color
    
    ask patch -24 -72 [
      set pcolor 2
    ]
    
    ask patch -24 -52 [
      set pcolor 2
    ]
    
    ask patch 24 -72 [
      set pcolor 2
    ]
    
    ask patch 24 -52 [
      set pcolor 2
    ]
  ]
  
  
  create-turtles 1 [
    pu
    set pen-size 5
    set color 0
    set heading 90
    setxy -20 -67
    
    
    ;Create 'S'
    pd
    
    fd 0.5
    repeat 16 [
      fd 0.4
      lt 10
    ]
    
    repeat 19 [
      fd 0.5
      rt 10
    ]
    
    
    ;Create 'e'
    pu
    setxy -11.5 -67
    set heading 245
    
    pd
    repeat 28 [
      fd 0.4
      rt 10
    ]
    set heading 155
    fd 0.3
    set heading 180 
    fd 0.3
    set heading 270
    fd 4
    
    
    ;Create 't' #1
    pu
    setxy -8 -67
    set heading 0
    
    pd
    fd 10
    rt 180
    fd 3
    rt 90
    fd 2
    rt 180
    fd 4
    
    
    ;Create 't' #2
    pu
    setxy -2 -67
    set heading 0
    
    pd
    fd 10
    rt 180
    fd 3
    rt 90
    fd 2
    rt 180
    fd 4
    
    
    ;Create 'i'
    pu
    setxy 2.5 -67
    set heading 0
    
    pd
    fd 5
    
    pu
    fd 2
    
    pd
    fd 0.1
    
    
    ;Create 'n'
    pu
    setxy 5.5 -67
    set heading 0
    
    pd
    fd 5
    rt 180
    fd 2
    set heading 45
    fd 0.2
    
    repeat 15 [
      fd 0.4
      rt 10
    ]
    
    set heading 180
    fd 1.75
    
    
    ;Create 'g'
    pu
    setxy 12 -67.8
    set heading 180
    
    pd
    
    fd 0.2
    repeat 18 [
      fd 0.3
      lt 10
    ]
    
    fd 6
    rt 180
    fd 1
    set heading 270
    
    fd 0.5
    repeat 18 [
      fd 0.3
      lt 10
    ]
    fd 0.5
    
    
    ;Create 's'
    pu
    setxy 18 -67
    set heading 160
    
    pd
    fd 0.2
    repeat 24 [
      fd 0.25
      lt 10
    ]
    
    repeat 24 [
      fd 0.25
      rt 10
    ]
    fd 0.2
    
    die
  ]
  
end





;Create the "Menu" button (settings screen)
to menu_button
  
  ask patches [
    
    ;Create the top and bottom of the "Menu" button
    if pycor = 90 and pxcor >= -90 and pxcor <= -40 [
      set pcolor 2
    ]
    
    if pycor = 89 and pxcor >= -91 and pxcor <= -39 [
      set pcolor 2
    ]
    
    if pycor = 66 and pxcor >= -90 and pxcor <= -40 [
      set pcolor 2
    ]
    
    if pycor = 67 and pxcor >= -91 and pxcor <= -39 [
      set pcolor 2
    ]
    
    
    ;Create the sides of the "Menu" button
    if pxcor = -91 and pycor <= 89 and pycor >= 68 [
      set pcolor 2
    ]
    
    if pxcor = -90 and pycor <= 90 and pycor >= 67 [
      set pcolor 2
    ]
    
    if pxcor = -39 and pycor <= 89 and pycor >= 68 [
      set pcolor 2
    ]
    
    if pxcor = -40 and pycor <= 90 and pycor >= 67 [
      set pcolor 2
    ]
    
    
    ;Fill inside with light grey
    if pxcor <= -41 and pxcor >= -89 and pycor <= 88 and pycor >= 68 [
      set pcolor 5.01
    ]
  ]
  
  ;Corners
  ask patch -41 88 [
    set pcolor 2
  ]
  
  ask patch -41 68 [
    set pcolor 2
  ]
  
  ask patch -89 88 [
    set pcolor 2
  ]
  
  ask patch -89 68 [
    set pcolor 2
  ]
  
  
  
  ;Set up the turtle that will write "Menu"
  create-turtles 1 [
    pu
    set pen-size 5
    set color black
    setxy -80 72
    set heading 0
  ]
  
  
  ask turtles [
    
    ;Create the 'M'
    pd
    fd 12
    
    set heading 145
    fd 7
    set heading 35
    fd 7
    
    set heading 180
    
    fd 12
    
    
    ;Create the 'e'
    pu
    setxy -65 72.5
    set heading 245
    
    pd
    repeat 28 [
      fd 0.4
      rt 10
    ]
    set heading 155
    fd 0.3
    set heading 180 
    fd 0.5
    set heading 270
    fd 4
    
    
    ;Create the 'n'
    pu
    setxy -61 72
    set heading 0
    
    pd
    fd 5
    rt 180
    fd 2
    set heading 45
    fd 0.2
    
    repeat 15 [
      fd 0.4
      rt 10
    ]
    
    set heading 180
    fd 1.5
    
    
    ;Create the 'u'
    pu
    setxy -54 76
    
    set heading 180
    pd
    fd 2.5
    
    repeat 18 [
      fd 0.3
      lt 10
    ]
    
    set heading 0
    fd 2.5
    
    die
  ]
end


;Create the color-picker palette
to color_select
  
  let color-X -80
  let color-Y 25
  let color-main 9
  
  
  ask patches [
    
    ;White layer
    if pxcor >= -80 and pxcor <= -11 and pycor >= 26 and pycor <= 30 [
      set pcolor 9.9
    ]
    
  ]
  
  ;Create the color box
  repeat 10 [
    repeat 5 [ 
      repeat 14 [
        repeat 5 [
          
          ask patch color-X color-Y [
            set pcolor color-main
          ]
          
          set color-X (color-x + 1)
        ]
        
        set color-main (color-main + 10)
      ]
      
      set color-X (color-X - 70)
      set color-Y (color-Y - 1)
    ]
    
    set color-main (color-main - 140)
    set color-main (color-main - 1)
  ]
  
  ;Outline the entire color box
  ask patches [
    
    if pxcor >= -82 and pxcor <= -9 and pycor >= 31 and pycor <= 32 [
      set pcolor 95
    ]
    
    if pxcor >= -82 and pxcor <= -9 and pycor <= -25 and pycor >= -26 [
      set pcolor orange
    ]
    
    if pxcor >= -82 and pxcor <= -81 and pycor <= 30 and pycor >= -24 [
      set pcolor orange
    ]
    
    if pxcor >= -10 and pxcor <= -9 and pycor <= 30 and pycor >= -24 [
      set pcolor 95
    ]
    
  ]
  
  
  create-turtles 1 [
    
    pu
    set color black
    set shape "color outline"
    set size 7
    
    if default-character? = true [
      setxy -48 28
    ]
    
    if default-character? = false [
      setxy color-selection-x color-selection-y
    ]
    
  ]
end



to icon_select
  
  
  ;Create the list of icon options
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -80 -65
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -55 -65
    
    set shape "person"
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -30 -65
    
    set shape "turtle"
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -5 -65
    
    set shape "truck"
  ]
  
  
  
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -80 -85
    
    set shape "chess pawn"
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -55 -85
    
    set shape "monster"
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -30 -85
    
    set shape "bowling pin"
  ]
  
  create-turtles 1 [
    set size 15
    set color 7
    set heading 0
    setxy -5 -85
    
    set shape "flower"
  ]
  
  
  
  ;Create the selector box for the icons
  create-turtles 1 [
    set size 26
    set shape "icon selection"
    setxy -55 -65
  ]
  
end




to settings_logo
  
  let set_logo bitmap:import "settings_logo.png"
  let scaled_set bitmap:scaled set_logo 375 375
  
  bitmap:copy-to-drawing scaled_set 210 -120
  
end


to color_heading
  
  let colored bitmap:import "color.png"
  let scaled_colored bitmap:scaled colored 150 150
  
  bitmap:copy-to-drawing scaled_colored 95 95
  
end


to icon_heading
  
  let icon bitmap:import "icon.png"
  let scaled_icon bitmap:scaled icon 125 125
  
  bitmap:copy-to-drawing scaled_icon 105 370
  
end



to preview_heading
  
  let preview bitmap:import "preview.png"
  let scaled_preview bitmap:scaled preview 200 200
  
  bitmap:copy-to-drawing scaled_preview 375 70
  
end


;;;;;;;;;;;;;;;;;;;;;;;
;; MAIN MENU PORTALS ;;
;;;;;;;;;;;;;;;;;;;;;;;



to menu_portals
  
  let inside_color 7
  
  let start_color 0.1
  let orange_color 22
  let blue_color 102
  
  ;Create the orange portal
  ask patches [
    
    ;Create the top curve
    if pxcor >= 53 and pxcor <= 82 and pycor = -19 [
      set pcolor start_color
    ]
    
    if pxcor >= 50 and pxcor <= 85 and pycor = -20 [
      set pcolor start_color
    ]
    
    if pxcor >= 48 and pxcor <= 87 and pycor = -21 [
      set pcolor start_color
    ]
    
    if pxcor >= 46 and pxcor <= 89 and pycor = -22 [
      set pcolor start_color
    ]
    
    if pxcor >= 45 and pxcor <= 90 and pycor = -23 [
      set pcolor start_color
    ]
    
    if pxcor >= 44 and pxcor <= 91 and pycor = -24 [
      set pcolor start_color
    ]
    
    
    ;Create the last of the top curve
    if pxcor >= 43 and pxcor <= 92 and pycor <= -25 and pycor >= -26 [
      set pcolor start_color
    ]
    
    if pxcor >= 42 and pxcor <= 93 and pycor <= -27 and pycor >= -28 [
      set pcolor start_color
    ]
    
    if pxcor >= 41 and pxcor <= 94 and pycor <= -29 and pycor >= -32 [
      set pcolor start_color
    ]
    
    if pxcor >= 40 and pxcor <= 95 and pycor <= -33 and pycor >= -36 [
      set pcolor start_color
    ]
    
    
    ;Create the edges
    if pxcor >= 39 and pxcor <= 96 and pycor <= -37 and pycor >= -78 [
      set pcolor start_color
    ]
    
    
    ;Create the first of the bottom curve
    if pxcor >= 40 and pxcor <= 95 and pycor <= -79 and pycor >= -82 [
      set pcolor start_color
    ]
    
    if pxcor >= 41 and pxcor <= 94 and pycor <= -83 and pycor >= -85 [
      set pcolor start_color
    ]
    
    if pxcor >= 42 and pxcor <= 93 and pycor <= -86 and pycor >= -87 [
      set pcolor start_color
    ]
    
    if pxcor >= 43 and pxcor <= 92 and pycor <= -88 and pycor >= -89 [
      set pcolor start_color
    ]
    
    
    
    ;Create the bottom curve
    if pxcor >= 44 and pxcor <= 91 and pycor = -90 [
      set pcolor start_color
    ]
    
    if pxcor >= 45 and pxcor <= 90 and pycor = -91 [
      set pcolor start_color
    ]
    
    if pxcor >= 46 and pxcor <= 89 and pycor = -92 [
      set pcolor start_color
    ]
    
    if pxcor >= 48 and pxcor <= 87 and pycor = -93 [
      set pcolor start_color
    ]
    
    if pxcor >= 50 and pxcor <= 85 and pycor = -94 [
      set pcolor start_color
    ]
    
    if pxcor >= 53 and pxcor <= 82 and pycor = -95 [
      set pcolor start_color
    ] 
  ]
  
  
  
  
  
  ;Create the blue portal
  ask patches [
    
    ;Create the top curve
    if pxcor <= -53 and pxcor >= -82 and pycor = -19 [
      set pcolor start_color
    ]
    
    if pxcor <= -50 and pxcor >= -85 and pycor = -20 [
      set pcolor start_color
    ]
    
    if pxcor <= -48 and pxcor >= -87 and pycor = -21 [
      set pcolor start_color
    ]
    
    if pxcor <= -46 and pxcor >= -89 and pycor = -22 [
      set pcolor start_color
    ]
    
    if pxcor <= -45 and pxcor >= -90 and pycor = -23 [
      set pcolor start_color
    ]
    
    if pxcor <= -44 and pxcor >= -91 and pycor = -24 [
      set pcolor start_color
    ]
    
    
    ;Create the last of the top curve
    if pxcor <= -43 and pxcor >= -92 and pycor <= -25 and pycor >= -26 [
      set pcolor start_color
    ]
    
    if pxcor <= -42 and pxcor >= -93 and pycor <= -27 and pycor >= -28 [
      set pcolor start_color
    ]
    
    if pxcor <= -41 and pxcor >= -94 and pycor <= -29 and pycor >= -32 [
      set pcolor start_color
    ]
    
    if pxcor <= -40 and pxcor >= -95 and pycor <= -33 and pycor >= -36 [
      set pcolor start_color
    ]
    
    
    ;Create the edges
    if pxcor <= -39 and pxcor >= -96 and pycor <= -37 and pycor >= -78 [
      set pcolor start_color
    ]
    
    
    ;Create the first of the bottom curve
    if pxcor <= -40 and pxcor >= -95 and pycor <= -79 and pycor >= -82 [
      set pcolor start_color
    ]
    
    if pxcor <= -41 and pxcor >= -94 and pycor <= -83 and pycor >= -85 [
      set pcolor start_color
    ]
    
    if pxcor <= -42 and pxcor >= -93 and pycor <= -86 and pycor >= -87 [
      set pcolor start_color
    ]
    
    if pxcor <= -43 and pxcor >= -92 and pycor <= -88 and pycor >= -89 [
      set pcolor start_color
    ]
    
    
    
    ;Create the bottom curve
    if pxcor <= -44 and pxcor >= -91 and pycor = -90 [
      set pcolor start_color
    ]
    
    if pxcor <= -45 and pxcor >= -90 and pycor = -91 [
      set pcolor start_color
    ]
    
    if pxcor <= -46 and pxcor >= -89 and pycor = -92 [
      set pcolor start_color
    ]
    
    if pxcor <= -48 and pxcor >= -87 and pycor = -93 [
      set pcolor start_color
    ]
    
    if pxcor <= -50 and pxcor >= -85 and pycor = -94 [
      set pcolor start_color
    ]
    
    if pxcor <= 53 and pxcor >= 82 and pycor = -95 [
      set pcolor start_color
    ]
  ]
  
  
  ;Color the insides
  ask patches with [pcolor = start_color] [
    if not any? patches with [distance myself = 3 and pcolor = black] [
      set pcolor 0.09
    ]
  ]
  
  
  ask patches with [pcolor = 0.09] [
    set pcolor black
  ]
  
  
  ask patches with [pcolor = 0.1 and pxcor <= -38] [
    set pcolor 101
  ]
  
  ask patches with [pcolor = 0.1 and pxcor >= 38] [
    set pcolor 21
  ]
  
  
  
  repeat 4 [
    
    wait 0.05
    
    ask patches with [pcolor = blue_color - 1] [
      set pcolor blue_color
    ]
    
    ask patches with [pcolor = orange_color - 1] [
      set pcolor orange_color
    ]
    
    set orange_color (orange_color + 1)
    set blue_color (blue_color + 1)
  ]
  
  ask patches with [pcolor = blue] [
    if any? patches with [distance myself = 1 and pcolor = black] [
      set pcolor 103
    ]
  ]
  
  ask patches with [pcolor = orange] [
    if any? patches with [distance myself = 1 and pcolor = black] [
      set pcolor 23
    ]
  ]
end


;Create the shimmering effect of the portals on the main menu
to menu_portal_colorize
  
  let blue_random_dark 0
  let blue_random_light 0
  
  let orange_random_dark 0
  let orange_random_light 0
  
  ask patches with [pcolor = 102 or pcolor = 103] [
    set blue_random_dark random 3
    
    if blue_random_dark = 1 [
      set pcolor 102
    ]
    
    if blue_random_dark = 2 [
      set pcolor 103
    ]
  ]
  
  ask patches with [pcolor = 104 or pcolor = 105 or pcolor = 106] [
    set blue_random_light random 4
    
    if blue_random_light = 1 [
      set pcolor 104
    ]
    
    if blue_random_light = 2 [
      set pcolor 105
    ]
    
    if blue_random_light = 3 [
      set pcolor 106
    ]
  ]
  
  
  
  ask patches with [pcolor = 22 or pcolor = 23] [
    set orange_random_dark random 3
    
    if orange_random_dark = 1 [
      set pcolor 22
    ]
    
    if orange_random_dark = 2 [
      set pcolor 23
    ]
  ]
  
  ask patches with [pcolor = 24 or pcolor = 25 or pcolor = 26] [
    set orange_random_light random 4
    
    if orange_random_light = 1 [
      set pcolor 24
    ]
    
    if orange_random_light = 2 [
      set pcolor 25
    ]
    
    if orange_random_light = 3 [
      set pcolor 26
    ]
  ]
  
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MENU BUTTON PROCEDURES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;



;Darkening effect when the "Play" button is pressed
to play_button_press
  
  ask patches with [pcolor = 5 and pycor >= -40] [
    set pcolor 4
  ]
  
end



;Darkening effect when the "Settings" button is pressed
to settings_button_press
  
  ask patches with [pcolor = 5 and pycor <= -40] [
    set pcolor 4
  ]
  
end



;Darkening effect when the "Menu" button is pressed
to menu_button_press
  
  ask patches with [pcolor = 5.1 and pycor >= 55] [
    set pcolor 4
  ]
  
end



;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TRANSITION PROCEDURES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;



to transition_from_menu
  
  let transition-y -100
  
  repeat 200 [
    
    wait 0.01
    
    ask patches with [pycor = transition-y] [
      set pcolor black
    ]
    
    set transition-y (transition-y + 1)
  ]
  
  
  clear-drawing
  
  let OG_logo_1 bitmap:import "planar_logo_1.png"
  let scaled_logo_1 bitmap:scaled OG_logo_1 500 500
  
  bitmap:copy-to-drawing scaled_logo_1 65 -100
  
  
  wait 0.05
  
  clear-drawing
  
  let OG_logo_2 bitmap:import "planar_logo_2.png"
  let scaled_logo_2 bitmap:scaled OG_logo_2 500 500
  
  bitmap:copy-to-drawing scaled_logo_2 65 -100
  
  
  wait 0.05
  
  clear-drawing
  
  let OG_logo_3 bitmap:import "planar_logo_3.png"
  let scaled_logo_3 bitmap:scaled OG_logo_3 500 500
  
  bitmap:copy-to-drawing scaled_logo_3 65 -100
  
  
  wait 0.05
  
  clear-drawing
  
  let OG_logo_4 bitmap:import "planar_logo_4.png"
  let scaled_logo_4 bitmap:scaled OG_logo_4 500 500
  
  bitmap:copy-to-drawing scaled_logo_4 65 -100
  
  ca
  
end]]></code>
